# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{sh,load-kernelsu}]
indent_size = 4

[*.{c,h}]
indent_size = 4

[*.{md,yml,yaml,conf}]
indent_size = 2

[*.{c,h}]
# kernel style: 8-wide tabs are used inside the patched sources
indent_style = tab
indent_size = 8

[patches/*.patch]
# Patch context must be preserved byte-for-byte.
trim_trailing_whitespace = false
insert_final_newline = false
