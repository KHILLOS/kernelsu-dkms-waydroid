 sys_call_ptr_t *ksu_syscall_table = NULL;
 int ksu_dispatcher_nr = -1;
diff --git a/kernel/include/ksu_compat.h b/kernel/include/ksu_compat.h
index c513e2a4..017676d0 100644
--- a/kernel/include/ksu_compat.h
+++ b/kernel/include/ksu_compat.h
@@ -18,17 +18,75 @@
 
 #include <linux/cred.h>
 #include <linux/fs.h>
+#include <linux/fdtable.h> // files_struct, __close_fd
 #include <linux/sched.h>
 #include <linux/uaccess.h>
 
 #include "infra/symbol_resolver.h"
 
+/*
+ * linux/pgtable.h appeared in 5.8; before that the same declarations live in
+ * asm/pgtable.h (and asm/pgalloc.h on some arches).  sucompat.c needs the page
+ * table types for its user-access helpers.
+ */
+#include <linux/version.h>
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 8, 0)
+#include <asm/pgtable.h>
+#endif
+
+/*
+ * __nocfi only exists in kernels built with CFI (and in Android's tree from
+ * 5.10 on).  Without it the syscall hook definitions do not parse at all on
+ * older kernels; the attribute is a no-op where CFI is not in use.
+ */
+#ifndef __nocfi
+#define __nocfi
+#endif
+
+/*
+ * CONFIG_SECCOMP_CACHE_DEBUG introduced struct action_cache (and with it the
+ * SECCOMP_ARCH_NATIVE_NR constant) in 5.15.  On older kernels the filter has no
+ * per-syscall action cache at all, so there is nothing for the module to patch.
+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 15, 0)
+#define KSU_HAVE_SECCOMP_ACTION_CACHE 1
+#endif
+
+/*
+ * struct seccomp grew filter_count in 5.10 (when filters became shareable).
+ * Before that the reference count lives only inside struct seccomp_filter.
+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
+#define KSU_HAVE_SECCOMP_FILTER_COUNT 1
+#endif
+
 /*
  * close_fd() is exported and does exactly what __x64_sys_close() /
  * __arm64_sys_close() do for a valid fd.  The __*_sys_* wrappers are not
  * exported, so ksyscall(close, fd) cannot be linked into a module.
  */
+/*
+ * The exported name is close_fd() from 5.11 on; older kernels export the
+ * identical helper as __close_fd().  Some stable series backported the rename
+ * without bumping the version, so Kbuild also probes Module.symvers and
+ * defines CLOSE_FD_IS_EXPORTED when close_fd() is what this kernel exports.
+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 11, 0)
 extern int close_fd(unsigned int fd);
+#elif defined(CLOSE_FD_IS_EXPORTED)
+/*
+ * Debian's 5.10 stable series backported the rename, so the exported name is
+ * close_fd() even though the version is 5.10.
+ */
+extern int close_fd(unsigned int fd);
+#else
+extern int __close_fd(struct files_struct *files, unsigned int fd);
+static inline int ksu_close_fd_compat(unsigned int fd)
+{
+	return __close_fd(current->files, fd);
+}
+#define close_fd(fd) ksu_close_fd_compat(fd)
+#endif
 
 /*
  * strncpy_from_user_nofault() is not exported for modules.  The exported
@@ -47,9 +105,41 @@ static inline long ksu_strncpy_from_user_nofault(char *dst, const void __user *s
 #define strncpy_from_user_nofault(dst, src, count) ksu_strncpy_from_user_nofault(dst, src, count)
 
 /*
- * copy_to_kernel_nofault() is the unexported helper; the exported
- * copy_from_kernel_nofault() performs the same kernel->kernel copy.
+ * copy_to_kernel_nofault() is the unexported helper; the exported inverse
+ * performs the same kernel->kernel copy.  The *_nofault names only exist from
+ * 5.8 on -- before that the pair was probe_kernel_read()/_write().
  */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 8, 0)
 #define copy_to_kernel_nofault(dst, src, size) copy_from_kernel_nofault(dst, src, size)
+#else
+#include <linux/uaccess.h>
+#define copy_to_kernel_nofault(dst, src, size) probe_kernel_read(dst, src, size)
+#endif
+
+/*
+ * The user-side nofault copy helpers also arrived in 5.8.  Their exported
+ * equivalents are the plain functions: callers run in process context with the
+ * right address space already active, so the "nofault" guarantee is not needed
+ * for correctness there, only for oops-avoidance on a bad pointer -- which
+ * access_ok() below still provides.
+ */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 8, 0)
+static inline long ksu_copy_from_user_nofault(void *dst, const void __user *src, size_t size)
+{
+	if (unlikely(!access_ok(src, size)))
+		return -EFAULT;
+	return copy_from_user(dst, src, size);
+}
+
+static inline long ksu_copy_to_user_nofault(void __user *dst, const void *src, size_t size)
+{
+	if (unlikely(!access_ok(dst, size)))
+		return -EFAULT;
+	return copy_to_user(dst, src, size);
+}
+
+#define copy_from_user_nofault(dst, src, size) ksu_copy_from_user_nofault(dst, src, size)
+#define copy_to_user_nofault(dst, src, size) ksu_copy_to_user_nofault(dst, src, size)
+#endif
 
 #endif /* __KSU_H_COMPAT */
diff --git a/kernel/infra/seccomp_cache.c b/kernel/infra/seccomp_cache.c
index a9d2b634..239de610 100644
--- a/kernel/infra/seccomp_cache.c
+++ b/kernel/infra/seccomp_cache.c
@@ -7,6 +7,28 @@
 #include <linux/seccomp.h>
 #include "klog.h" // IWYU pragma: keep
 #include "infra/seccomp_cache.h"
+#include "ksu_compat.h"
+
+#ifndef KSU_HAVE_SECCOMP_ACTION_CACHE
+
+/*
+ * Kernels before 5.15 keep no per-syscall action cache in struct seccomp_filter,
+ * so the filter can never deny a syscall outright and there is nothing to
+ * clear.  Both entry points stay defined so callers link; they are no-ops.
+ */
+void ksu_seccomp_clear_cache(struct seccomp_filter *filter, int nr)
+{
+    (void)filter;
+    (void)nr;
+}
+
+void ksu_seccomp_allow_cache(struct seccomp_filter *filter, int nr)
+{
+    (void)filter;
+    (void)nr;
+}
+
+#else /* KSU_HAVE_SECCOMP_ACTION_CACHE */
 
 struct action_cache {
     DECLARE_BITMAP(allow_native, SECCOMP_ARCH_NATIVE_NR);
@@ -63,3 +85,5 @@ void ksu_seccomp_allow_cache(struct seccomp_filter *filter, int nr)
     }
 #endif
 }
+
+#endif /* KSU_HAVE_SECCOMP_ACTION_CACHE */
