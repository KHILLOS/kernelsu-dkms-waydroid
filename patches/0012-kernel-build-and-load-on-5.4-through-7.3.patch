diff --git a/kernel/policy/allowlist.c b/kernel/policy/allowlist.c
index e5735d67..5e22ae58 100644
--- a/kernel/policy/allowlist.c
+++ b/kernel/policy/allowlist.c
@@ -3,6 +3,7 @@
 #include <linux/rculist.h>
 #include <linux/mutex.h>
 #include <linux/task_work.h>
+#include <linux/sched/task.h> // TWA_RESUME, put_task_struct
 #include <linux/capability.h>
 #include <linux/compiler.h>
 #include <linux/fs.h>
@@ -478,7 +479,16 @@ void ksu_persistent_allow_list()
         goto put_task;
     }
     cb->func = do_persistent_allow_list;
+    /*
+     * TWA_RESUME (and the enum task_work_notify_mode it belongs to) only exists
+     * from 5.10; on older kernels task_work_add() takes a plain "notify"
+     * boolean with the same meaning.
+     */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
     if (task_work_add(tsk, cb, TWA_RESUME)) {
+#else
+    if (task_work_add(tsk, cb, true)) {
+#endif
         kfree(cb);
         pr_warn("save_allow_list add task_work failed\n");
     }
diff --git a/kernel/policy/app_profile.c b/kernel/policy/app_profile.c
index 037483ed..c1f3ff69 100644
--- a/kernel/policy/app_profile.c
+++ b/kernel/policy/app_profile.c
@@ -18,6 +18,7 @@
 #include "selinux/selinux.h"
 #include "infra/su_mount_ns.h"
 #include "hook/tp_marker.h"
+#include "ksu_compat.h"
 
 /*
  * seccomp_filter_release(), alloc_uid() and set_cred_ucounts() are internal
@@ -134,7 +135,9 @@ static void disable_seccomp(void)
 
     current->seccomp.mode = 0;
     current->seccomp.filter = NULL;
+#ifdef KSU_HAVE_SECCOMP_FILTER_COUNT
     atomic_set(&current->seccomp.filter_count, 0);
+#endif
     spin_unlock_irq(&current->sighand->siglock);
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 11, 0)
diff --git a/kernel/sulog/event.c b/kernel/sulog/event.c
index fcccbc2f..8256495d 100644
