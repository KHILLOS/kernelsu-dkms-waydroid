From aa578dc9192aba58c87a8ccc84b15ccab28d05ed Mon Sep 17 00:00:00 2001
From: z <x@y>
Date: Tue, 10 Nov 2026 07:49:37 +0000
Subject: [PATCH] kernel: build and load on 5.4 through 7.3

---
 kernel/Kbuild                      | 13 +++++
 kernel/feature/sucompat.c          |  5 ++
 kernel/hook/syscall_event_bridge.c |  1 +
 kernel/hook/x86_64/syscall_hook.c  |  1 +
 kernel/include/ksu_compat.h        | 94 +++++++++++++++++++++++++++++-
 kernel/infra/seccomp_cache.c       | 24 ++++++++
 kernel/infra/symbol_resolver.c     |  1 +
 kernel/policy/allowlist.c          | 10 ++++
 kernel/policy/app_profile.c        |  3 +
 kernel/sulog/event.c               |  5 ++
 kernel/supercall/dispatch.c        |  2 +
 kernel/supercall/supercall.c       |  6 ++
 12 files changed, 163 insertions(+), 2 deletions(-)

diff --git a/kernel/Kbuild b/kernel/Kbuild
index 3f4209db..3eab5b9f 100644
--- a/kernel/Kbuild
+++ b/kernel/Kbuild
@@ -164,6 +164,19 @@ $(info -- KernelSU: LSM layout: hook heads)
 ifneq ($(KSU_LSM_HAS_LSMID),0)
 ccflags-y += -DKSU_LSM_HOOK_HAS_LSMID=1
 endif
+
+# close_fd() vs __close_fd(): the rename happened in 5.11 upstream, but stable
+# series (Debian's 5.10, for one) backported it, so ask Module.symvers which one
+# this kernel actually exports instead of trusting the version number.
+KSU_SYMVERS := $(firstword $(wildcard $(objtree)/Module.symvers $(srctree)/Module.symvers))
+ifneq ($(KSU_SYMVERS),)
+ifneq ($(shell grep -cE '(^|[^_a-zA-Z0-9])close_fd[[:space:]]' $(KSU_SYMVERS) 2>/dev/null),0)
+ccflags-y += -DCLOSE_FD_IS_EXPORTED=1
+$(info -- KernelSU: exported name close_fd)
+else
+$(info -- KernelSU: exported name __close_fd)
+endif
+endif
 endif
 
 obj-$(CONFIG_KSU) += kernelsu.o
