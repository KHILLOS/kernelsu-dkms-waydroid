From d71c940b420ea87fc2f2cb41c452b8906cea6ce0 Mon Sep 17 00:00:00 2001
From: z <x@y>
Date: Mon, 9 Nov 2026 20:00:10 +0000
Subject: [PATCH] selinux-none

---
 kernel/selinux/selinux_none.c | 134 ++++++++++++++++++++++++++++++++++
 1 file changed, 134 insertions(+)
 create mode 100644 kernel/selinux/selinux_none.c

diff --git a/kernel/selinux/selinux_none.c b/kernel/selinux/selinux_none.c
new file mode 100644
index 0000000..f04f276
--- /dev/null
+++ b/kernel/selinux/selinux_none.c
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * selinux_none.c - no-op SELinux backend for CONFIG_KSU_SELINUX=n
+ *
+ * Compiling selinux/selinux.c requires the kernel's private SELinux headers
+ * (security/selinux/objsec.h, security/selinux/include/*, ss/policydb.h) which
+ * no distro kernel-headers package ships, and which expose structs
+ * (inode_security_struct, selinux_state, policydb) that are not ABI-stable and
+ * are not exported.  An out-of-tree module therefore cannot use the SELinux
+ * backend on a generic distro kernel.
+ *
+ * With CONFIG_KSU_SELINUX=n we still have to define every symbol the rest of
+ * the module calls, otherwise modpost fails with "undefined!" errors.  This
+ * file provides them as no-ops so the non-SELinux configuration links and
+ * loads.
+ *
+ * Consequences (documented in README.md):
+ *   - KernelSU does not move its own processes into a "ksu" SELinux domain;
+ *     the caller keeps its existing (e.g. "unconfined") context.
+ *   - Custom sepolicy rules requested by ksud are ignored.
+ *   - SELinux hiding is unavailable.
+ *   - Root escalation still works: uid/gid/capabilities change, only the
+ *     SELinux label is left untouched.
+ */
+
+#include <linux/cred.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/types.h>
+
+#include "feature/selinux_hide.h"
+#include "klog.h" // IWYU pragma: keep
+#include "selinux/selinux.h"
+
+/*
+ * Declared `extern u32 ksu_file_sid` in selinux.h and referenced from
+ * ksu_install_file_wrapper().  0 means "do not relabel".
+ */
+u32 ksu_file_sid __read_mostly = 0;
+
+void setup_selinux(const char *domain, struct cred *cred)
+{
+	/* keep the caller's existing SELinux context */
+}
+
+void setenforce(bool enforce)
+{
+	/* never change the host's global SELinux enforcement state */
+}
+
+bool getenforce(void)
+{
+	/*
+	 * Report "enforcing" so core/init.c does not try to flip the host
+	 * policy from permissive to enforcing.
+	 */
+	return true;
+}
+
+void cache_sid(void)
+{
+	/* no SID cache without the SELinux backend */
+}
+
+bool is_task_ksu_domain(const struct cred *cred)
+{
+	return false;
+}
+
+bool is_ksu_domain(void)
+{
+	return false;
+}
+
+bool is_zygote(const struct cred *cred)
+{
+	return false;
+}
+
+bool is_init(const struct cred *cred)
+{
+	return false;
+}
+
+bool is_adbd(const struct cred *cred)
+{
+	return false;
+}
+
+void apply_kernelsu_rules(void)
+{
+	/* cannot inject sepolicy rules without the SELinux backend */
+}
+
+int handle_sepolicy(void __user *user_data, u64 data_len)
+{
+	/*
+	 * -EOPNOTSUPP tells ksud this kernel was built without SELinux
+	 * support, so it treats it as "no rules to install".
+	 */
+	return -EOPNOTSUPP;
+}
+
+void setup_ksu_cred(void)
+{
+	/* ksu_cred stays a plain root cred, just without a ksu label */
+}
+
+void escape_to_root_for_adb_root(void)
+{
+	/* implemented in feature/adb_root.c for the SELinux path */
+}
+
+/* ---- feature/selinux_hide.h (not compiled when SELinux is off) ---- */
+
+void ksu_selinux_hide_init()
+{
+}
+
+void ksu_selinux_hide_exit()
+{
+}
+
+void ksu_selinux_hide_drop_backup_if_unused()
+{
+}
+
+void ksu_selinux_hide_handle_second_stage()
+{
+}
+
+void ksu_selinux_hide_handle_post_fs_data()
+{
+}
