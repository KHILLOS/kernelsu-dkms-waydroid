index c11eb9d..55d43c9 100644
--- a/kernel/hook/syscall_hook_manager.c
+++ b/kernel/hook/syscall_hook_manager.c
@@ -14,6 +14,7 @@
 #include "arch.h"
 #include "klog.h" // IWYU pragma: keep
 #include "hook/syscall_hook_manager.h"
+#include "infra/symbol_resolver.h"
 #include "hook/tp_marker.h"
 #include "feature/sucompat.h"
 #include "hook/setuid_hook.h"
@@ -93,6 +94,8 @@ static struct kretprobe *syscall_unregfunc_rp = NULL;
 #endif
 
 #ifdef CONFIG_HAVE_SYSCALL_TRACEPOINTS
+static struct tracepoint *ksu_sys_enter_tp;
+
 // sys_enter handler: redirect hooked syscalls to the dispatcher
 static void ksu_sys_enter_handler(void *data, struct pt_regs *regs, long id)
 {
@@ -143,7 +146,19 @@ void __init ksu_syscall_hook_manager_init(void)
     ksu_register_syscall_hook(__NR_faccessat, ksu_hook_faccessat);
 
 #ifdef CONFIG_HAVE_SYSCALL_TRACEPOINTS
-    ret = register_trace_prio_sys_enter(ksu_sys_enter_handler, NULL, INT_MIN);
+    /*
+     * register_trace_prio_sys_enter() expands to a reference to
+     * __tracepoint_sys_enter, which is not EXPORT_SYMBOL'd and therefore cannot
+     * be used from a module.  Use the exported
+     * tracepoint_probe_register_prio() with the runtime-resolved tracepoint.
+     */
+    ksu_sys_enter_tp = (struct tracepoint *)ksu_lookup_symbol_kprobe("__tracepoint_sys_enter");
+    if (!ksu_sys_enter_tp) {
+        pr_warn("hook_manager: __tracepoint_sys_enter not found, sys_enter hooking disabled\n");
+        ret = -ENOENT;
+    } else {
+        ret = tracepoint_probe_register_prio(ksu_sys_enter_tp, ksu_sys_enter_handler, NULL, INT_MIN);
+    }
 #ifndef CONFIG_KRETPROBES
     ksu_mark_running_process_locked();
 #endif
@@ -162,8 +177,10 @@ void __exit ksu_syscall_hook_manager_exit(void)
 {
     pr_info("hook_manager: ksu_hook_manager_exit called\n");
 #ifdef CONFIG_HAVE_SYSCALL_TRACEPOINTS
-    unregister_trace_sys_enter(ksu_sys_enter_handler, NULL);
-    tracepoint_synchronize_unregister();
+    if (ksu_sys_enter_tp) {
+        tracepoint_probe_unregister(ksu_sys_enter_tp, ksu_sys_enter_handler, NULL);
+        tracepoint_synchronize_unregister();
+    }
     pr_info("hook_manager: sys_enter tracepoint unregistered\n");
 #endif
 
diff --git a/kernel/hook/tp_marker.c b/kernel/hook/tp_marker.c
index c78bbbd..b3ceed7 100644
--- a/kernel/hook/tp_marker.c
+++ b/kernel/hook/tp_marker.c
@@ -1,4 +1,5 @@
 #include "hook/tp_marker.h"
+#include "infra/symbol_resolver.h"
 
 #include "linux/cred.h"
 #include <linux/spinlock.h>
@@ -51,18 +52,38 @@ void ksu_clear_task_tracepoint_flag_if_needed(struct task_struct *t)
     spin_unlock_irqrestore(&tracepoint_reg_lock, flags);
 }
 
+/*
+ * tasklist_lock and find_task_by_vpid() are not exported to modules, so they
+ * are resolved at runtime.
+ */
+static rwlock_t *ksu_tasklist_lock_sym;
+typedef struct task_struct *(*ksu_find_task_by_vpid_fn)(pid_t nr);
+static ksu_find_task_by_vpid_fn ksu_find_task_by_vpid_sym;
+
+static void ksu_tp_marker_resolve(void)
+{
+    if (!ksu_tasklist_lock_sym)
+        ksu_tasklist_lock_sym = (rwlock_t *)ksu_lookup_symbol_kprobe("tasklist_lock");
+    if (!ksu_find_task_by_vpid_sym)
+        ksu_find_task_by_vpid_sym =
+            (ksu_find_task_by_vpid_fn)ksu_lookup_symbol_kprobe("find_task_by_vpid");
+}
+
 // Process marking management
 static void handle_process_mark(bool mark)
 {
     struct task_struct *p, *t;
-    read_lock(&tasklist_lock);
+    ksu_tp_marker_resolve();
+    if (!ksu_tasklist_lock_sym)
+        return;
+    read_lock(ksu_tasklist_lock_sym);
     for_each_process_thread (p, t) {
         if (mark)
             ksu_set_task_tracepoint_flag(t);
         else
             ksu_clear_task_tracepoint_flag(t);
     }
-    read_unlock(&tasklist_lock);
+    read_unlock(ksu_tasklist_lock_sym);
 }
 
 void ksu_mark_all_process(void)
@@ -80,7 +101,10 @@ void ksu_unmark_all_process(void)
 void ksu_mark_running_process_locked(void)
 {
     struct task_struct *p, *t;
-    read_lock(&tasklist_lock);
+    ksu_tp_marker_resolve();
+    if (!ksu_tasklist_lock_sym)
+        return;
+    read_lock(ksu_tasklist_lock_sym);
     for_each_process_thread (p, t) {
         if (t->pid != 1 && !t->mm) {
             // skip kernel threads, but always allow pid 1
@@ -102,7 +126,7 @@ void ksu_mark_running_process_locked(void)
         }
         put_cred(cred);
     }
-    read_unlock(&tasklist_lock);
+    read_unlock(ksu_tasklist_lock_sym);
 }
 
 void ksu_mark_running_process(void)
@@ -125,7 +149,7 @@ int ksu_get_task_mark(pid_t pid)
     int marked = -ESRCH;
 
     rcu_read_lock();
-    task = find_task_by_vpid(pid);
+    task = ksu_find_task_by_vpid_sym ? ksu_find_task_by_vpid_sym(pid) : NULL;
     if (task) {
         get_task_struct(task);
         rcu_read_unlock();
@@ -150,7 +174,7 @@ int ksu_set_task_mark(pid_t pid, bool mark)
     int ret = -ESRCH;
 
     rcu_read_lock();
-    task = find_task_by_vpid(pid);
+    task = ksu_find_task_by_vpid_sym ? ksu_find_task_by_vpid_sym(pid) : NULL;
     if (task) {
         get_task_struct(task);
         rcu_read_unlock();
