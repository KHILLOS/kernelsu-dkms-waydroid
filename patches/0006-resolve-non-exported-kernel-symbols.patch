+        return;
+    }
+
+    long ret = ksu_ksys_unshare_sym(CLONE_NEWNS);
     if (ret) {
         pr_warn("call ksys_unshare failed: %ld\n", ret);
         return;
@@ -125,7 +180,8 @@ static void ksu_mnt_ns_individual(void)
