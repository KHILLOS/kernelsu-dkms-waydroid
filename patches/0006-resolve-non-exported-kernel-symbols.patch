diff --git a/kernel/hook/lsm_hook.c b/kernel/hook/lsm_hook.c
index 4598c6b..a4ad815 100644
--- a/kernel/hook/lsm_hook.c
+++ b/kernel/hook/lsm_hook.c
@@ -14,6 +14,29 @@
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0)
 #include "linux/static_call.h"
 #endif
+
+/*
+ * kallsyms_lookup_size_offset() is internal and not exported to modules, so an
+ * out-of-tree build cannot query a symbol's extent.  The only consumer here
+ * uses the size as an upper bound for a read-only scan of a kernel data
+ * structure, so a conservative constant is used instead of probing.
+ *
+ * KSU_SYM_SIZE_MAX covers the largest structure scanned
+ * (struct lsm_static_calls_table) with headroom; scanning a little too far is
+ * harmless because the scan validates what it decodes.
+ */
+#define KSU_SYM_SIZE_MAX 4096UL
+
+static bool ksu_symbol_size(unsigned long addr, unsigned long *size)
+{
+	if (!addr) {
+		pr_warn("ksu: symbol address unavailable\n");
+		return false;
+	}
+
+	*size = KSU_SYM_SIZE_MAX;
+	return true;
+}
 struct ksu_lsm_hook_entry {
     struct ksu_lsm_hook *hook;
 };
@@ -148,7 +171,7 @@ int ksu_lsm_hook(struct ksu_lsm_hook *hook)
     if (scalls_count == 0) {
         unsigned long sym_size = sizeof(struct lsm_static_calls_table);
         u32 lsm_active_cnt = 5;
-        if (!kallsyms_lookup_size_offset(scalls_addr, &sym_size, NULL)) {
+        if (!ksu_symbol_size(scalls_addr, &sym_size)) {
             pr_err("failed to get size\n");
         }
         unsigned long addr = find_kernel_symbol_exact("lsm_active_cnt");
@@ -284,7 +307,7 @@ int ksu_lsm_hook(struct ksu_lsm_hook *hook)
         goto out_unlock;
     }
     unsigned long heads_size = sizeof(struct security_hook_heads);
-    if (!kallsyms_lookup_size_offset(heads_addr, &heads_size, NULL)) {
+    if (!ksu_symbol_size(heads_addr, &heads_size)) {
         pr_warn("lookup head size failed");
     }
 
