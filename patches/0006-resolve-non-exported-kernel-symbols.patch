+	if (!ksu_ns_get_path_sym)
+		ksu_ns_get_path_sym = (ksu_ns_get_path_fn)ksu_lookup_symbol_kprobe("ns_get_path");
+	if (!ksu_mntns_operations_sym)
+		ksu_mntns_operations_sym =
+			(const struct proc_ns_operations *)ksu_lookup_symbol_kprobe("mntns_operations");
+
+	if (!ksu_path_mount_sym || !ksu_ksys_unshare_sym)
