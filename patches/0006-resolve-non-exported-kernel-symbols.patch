diff --git a/kernel/feature/kernel_umount.c b/kernel/feature/kernel_umount.c
index 7e337ab..8738d75 100644
--- a/kernel/feature/kernel_umount.c
+++ b/kernel/feature/kernel_umount.c
@@ -11,6 +11,7 @@
 #include <linux/types.h>
 
 #include "feature/kernel_umount.h"
+#include "infra/symbol_resolver.h"
 #include "klog.h" // IWYU pragma: keep
 #include "policy/allowlist.h"
 #include "selinux/selinux.h"
@@ -41,11 +42,20 @@ static const struct ksu_feature_handler kernel_umount_handler = {
     .set_handler = kernel_umount_feature_set,
 };
 
-extern int path_umount(struct path *path, int flags);
+/* path_umount() is not exported to modules; resolve it at runtime. */
+typedef int (*ksu_path_umount_fn)(struct path *path, int flags);
+static ksu_path_umount_fn ksu_path_umount_sym;
 
 static void ksu_umount_mnt(const char *mnt, struct path *path, int flags)
 {
-    int err = path_umount(path, flags);
+    if (!ksu_path_umount_sym)
+        ksu_path_umount_sym = (ksu_path_umount_fn)ksu_lookup_symbol_kprobe("path_umount");
+    if (!ksu_path_umount_sym) {
+        pr_info("umount %s skipped: path_umount unavailable\n", mnt);
+        return;
+    }
+
+    int err = ksu_path_umount_sym(path, flags);
     if (err) {
         pr_info("umount %s failed: %d\n", mnt, err);
     }
