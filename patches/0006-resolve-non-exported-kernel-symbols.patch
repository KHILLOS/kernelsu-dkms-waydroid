+static ksu_path_mount_fn ksu_path_mount_sym;
+static ksu_set_fs_pwd_fn ksu_set_fs_pwd_sym;
+static ksu_ksys_unshare_fn ksu_ksys_unshare_sym;
+static ksu_ns_get_path_fn ksu_ns_get_path_sym;
