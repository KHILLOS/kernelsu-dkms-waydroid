diff --git a/kernel/include/ksu_compat.h b/kernel/include/ksu_compat.h
new file mode 100644
index 0000000..c513e2a
--- /dev/null
+++ b/kernel/include/ksu_compat.h
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ksu_compat.h - out-of-tree (DKMS/LKM) compatibility shims
+ *
+ * Upstream KernelSU is normally compiled as part of the kernel image, so it may
+ * call internal (non-exported) helpers freely.  A DKMS module links against the
+ * kernel's EXPORT_SYMBOL() table only; every reference to a non-exported symbol
+ * is a hard modpost error ("... undefined!") and, if that error is ignored with
+ * KBUILD_MODPOST_WARN=1, an unloadable module.
+ *
+ * This header maps the few non-exported helpers KernelSU uses onto exported
+ * equivalents.  Anything without an exported equivalent is resolved at runtime
+ * through infra/symbol_resolver.h instead.
+ */
+
+#ifndef __KSU_H_COMPAT
+#define __KSU_H_COMPAT
+
+#include <linux/cred.h>
+#include <linux/fs.h>
+#include <linux/sched.h>
+#include <linux/uaccess.h>
+
+#include "infra/symbol_resolver.h"
+
+/*
+ * close_fd() is exported and does exactly what __x64_sys_close() /
+ * __arm64_sys_close() do for a valid fd.  The __*_sys_* wrappers are not
+ * exported, so ksyscall(close, fd) cannot be linked into a module.
+ */
+extern int close_fd(unsigned int fd);
+
+/*
+ * strncpy_from_user_nofault() is not exported for modules.  The exported
+ * strncpy_from_user() is equivalent for every KernelSU call site: they all run
+ * in process context with the address space of `current` active and pass a
+ * userspace pointer taken from a syscall hook.
+ */
+static inline long ksu_strncpy_from_user_nofault(char *dst, const void __user *src, long count)
+{
+	if (unlikely(!access_ok(src, (unsigned long)count)))
+		return -EFAULT;
+
+	return strncpy_from_user(dst, src, count);
+}
+
+#define strncpy_from_user_nofault(dst, src, count) ksu_strncpy_from_user_nofault(dst, src, count)
+
+/*
+ * copy_to_kernel_nofault() is the unexported helper; the exported
+ * copy_from_kernel_nofault() performs the same kernel->kernel copy.
+ */
+#define copy_to_kernel_nofault(dst, src, size) copy_from_kernel_nofault(dst, src, size)
+
+#endif /* __KSU_H_COMPAT */
diff --git a/kernel/infra/symbol_resolver.c b/kernel/infra/symbol_resolver.c
index f957669..fae10c1 100644
--- a/kernel/infra/symbol_resolver.c
+++ b/kernel/infra/symbol_resolver.c
@@ -1,189 +1,113 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * symbol_resolver.c - resolve kernel symbols from an out-of-tree module
+ *
+ * Why this differs from upstream
+ * ------------------------------
+ * Upstream KernelSU is normally built inside the kernel tree, where it can
+ * call non-exported helpers such as kallsyms_lookup_name() and
+ * kallsyms_on_each_symbol() directly.  An out-of-tree module (which is what a
+ * DKMS package is) may only reference EXPORT_SYMBOL()'d symbols, so all of the
+ * following are hard modpost errors for us:
+ *
+ *     kallsyms_lookup_name
+ *     kallsyms_on_each_symbol
+ *     kallsyms_on_each_match_symbol
+ *     kallsyms_lookup_size_offset
+ *
+ * register_kprobe() *is* exported, and a kprobe names the symbol it wants, so
+ * the kernel's own kallsyms machinery resolves the address.  That is the
+ * primitive used here; every other non-exported symbol the module needs
+ * (path_mount, set_fs_pwd, tasklist_lock, ...) is obtained through it.
+ */
+
+#include <linux/err.h>
 #include <linux/kallsyms.h>
+#include <linux/kprobes.h>
 #include <linux/module.h>
 #include <linux/string.h>
 #include <linux/version.h>
 
 #include "infra/symbol_resolver.h"
+#include "klog.h" // IWYU pragma: keep
 
-// https://github.com/torvalds/linux/commit/89245600941e4e0f87d77f60ee269b5e61ef4e49
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
-#define USE_KCFI 1
-#else
-#define USE_KCFI 0
-#endif
-
-#if !USE_KCFI
-static const char cfi_suffix[] = ".cfi_jt";
-static const size_t cfi_suffix_len = sizeof(cfi_suffix) - 1;
-#endif
-
-// It's not guaranteed to have this symbol exist in 5.x kernel
-// https://github.com/torvalds/linux/commit/d721def7392a7348ffb9f3583b264239cbd3702c
-// https://github.com/gregkh/linux/commit/2aa861ec72908b4bdc20d74725dc1c8c71a8d214
-// https://github.com/gregkh/linux/commit/318a206633c248d876ea72f7133d2a2e50ad7e35
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 19, 0)
-#define ALWAYS_HAVE_ON_EACH_SYMBOL 1
-#else
-#define ALWAYS_HAVE_ON_EACH_SYMBOL 0
-#endif
-
-#if !ALWAYS_HAVE_ON_EACH_SYMBOL
-static int (*kallsyms_on_each_symbol_fn)(int (*fn)(void *, const char *, struct module *, unsigned long),
-                                         void *data) = NULL;
-#endif
-
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
-#define HAVE_ON_EACH_MATCH_SYMBOL 1
-#else
-#define HAVE_ON_EACH_MATCH_SYMBOL 0
-#endif
-
-// https://github.com/torvalds/linux/commit/4dc533e0f2c04174e1ae4aa98e7cffc1c04b9998
-#if HAVE_ON_EACH_MATCH_SYMBOL
-static int (*kallsyms_on_each_match_symbol_fn)(int (*fn)(void *, unsigned long), const char *name, void *data) = NULL;
-static int find_kernel_symbol_exact_cb(void *data, unsigned long addr)
-{
-    *(unsigned long *)data = addr;
-    return 0;
-}
-#endif
-
-struct ksu_lookup_symbol_ctx {
-    const char *symbol_name;
-    size_t symbol_len;
-    void *match;
+/* A kprobe resolved by name needs a writable copy of the name. */
+struct ksu_kprobe_name {
+	struct kprobe kp;
+	char name[KSYM_NAME_LEN];
 };
 
-unsigned long __nocfi find_kernel_symbol_exact(const char *symbol_name)
+static int ksu_kprobe_pre_handler(struct kprobe *p, struct pt_regs *regs)
 {
-    unsigned long addr = 0;
-#if HAVE_ON_EACH_MATCH_SYMBOL
-    if (likely(kallsyms_on_each_match_symbol_fn)) {
-        kallsyms_on_each_match_symbol_fn(find_kernel_symbol_exact_cb, symbol_name, &addr);
-        return addr;
-    }
-#endif
-    char *module_name = NULL;
-    char buf[KSYM_SYMBOL_LEN];
-
-    addr = kallsyms_lookup_name(symbol_name);
-    // check if it is kernel symbol
-    kallsyms_lookup(addr, NULL, NULL, &module_name, buf);
-    if (unlikely(module_name)) {
-        pr_warn("ignore symbol %s of module %s\n", symbol_name, module_name);
-        return 0;
-    }
-    return addr;
+	return 0;
 }
 
-static inline bool ksu_symbol_has_suffix(const char *name, size_t name_len, const char *suffix, size_t suffix_len)
+/*
+ * Resolve any kernel symbol by name, including symbols that are not exported
+ * to modules.  Returns 0 when the symbol does not exist in this kernel.
+ *
+ * Call from process context during init and cache the result; the lookup walks
+ * kallsyms and is not cheap.
+ */
+unsigned long ksu_lookup_symbol_kprobe(const char *name)
 {
-    return name_len >= suffix_len && strcmp(name + name_len - suffix_len, suffix) == 0;
-}
+	struct ksu_kprobe_name kpn;
+	unsigned long addr;
+	int ret;
 
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
-static int lookup_symbol_variant_cb(void *data, const char *name, unsigned long addr)
-#else
-static int lookup_symbol_variant_cb(void *data, const char *name, struct module *mod, unsigned long addr)
-#endif
-{
-    struct ksu_lookup_symbol_ctx *ctx = data;
-    size_t name_len;
-
-    if (!name || !addr)
-        return 0;
-
-    name_len = strlen(name);
-
-    if (strcmp(name, ctx->symbol_name) != 0) {
-        if (name_len <= ctx->symbol_len || strncmp(name, ctx->symbol_name, ctx->symbol_len) != 0 ||
-            (name[ctx->symbol_len] != '.' && name[ctx->symbol_len] != '$'))
-            return 0;
-    }
-
-#if !USE_KCFI
-    if (ksu_symbol_has_suffix(name, name_len, cfi_suffix, cfi_suffix_len)) {
-        ctx->match = (void *)addr;
-        pr_info("use .cfi_jt variant: %s\n", name);
-        return 1;
-    }
-#endif
-
-    if (!ctx->match) {
-        ctx->match = (void *)addr;
-        pr_info("found variant: %s\n", name);
-#if USE_KCFI
-        return 1;
-#endif
-    }
-
-    return 0;
-}
+	if (!name || !*name)
+		return 0;
 
-static __nocfi void *resolve_symbol_variant(const char *symbol_name, size_t symbol_len)
-{
-    struct ksu_lookup_symbol_ctx ctx = {
-        .symbol_name = symbol_name,
-        .symbol_len = symbol_len,
-    };
-
-#if !ALWAYS_HAVE_ON_EACH_SYMBOL
-    if (kallsyms_on_each_symbol_fn) {
-        kallsyms_on_each_symbol_fn(lookup_symbol_variant_cb, &ctx);
-    }
-    // TODO: iterate kallsyms by sprint_symbol
-#else
-    kallsyms_on_each_symbol(lookup_symbol_variant_cb, &ctx);
-#endif
-    return ctx.match;
-}
+	if (strlen(name) >= sizeof(kpn.name))
+		return 0;
 
-void *ksu_resolve_symbol_for_functable_hook(const char *symbol_name)
-{
-    void *addr;
-    size_t symbol_len;
+	memset(&kpn, 0, sizeof(kpn));
+	strscpy(kpn.name, name, sizeof(kpn.name));
+	kpn.kp.symbol_name = kpn.name;
+	kpn.kp.pre_handler = ksu_kprobe_pre_handler;
 
-    if (!symbol_name || !symbol_name[0])
-        return NULL;
+	ret = register_kprobe(&kpn.kp);
+	if (ret) {
+		pr_debug("ksu: kprobe lookup of %s failed: %d\n", name, ret);
+		return 0;
+	}
 
-    symbol_len = strlen(symbol_name);
+	addr = (unsigned long)kpn.kp.addr;
+	unregister_kprobe(&kpn.kp);
 
-    // Prefer find_kernel_symbol_exact since it uses binary search in higher kernel version
+	return addr;
+}
 
-#if !USE_KCFI
-    // Try .cfi_jt suffix first
-    char cfi_name[KSYM_NAME_LEN];
-    snprintf(cfi_name, sizeof(cfi_name), "%s.cfi_jt", symbol_name);
-    addr = (void *)find_kernel_symbol_exact(cfi_name);
-    if (addr)
-        return addr;
+/*
+ * Single lookup entry point used by the rest of the module.  On kernels built
+ * with CFI the symbol may carry a jump-table suffix, so the plain name is tried
+ * first and the ".cfi_jt" variant second.
+ */
+unsigned long __nocfi find_kernel_symbol_exact(const char *symbol_name)
+{
+	unsigned long addr;
+	char alt[KSYM_NAME_LEN];
 
-    addr = resolve_symbol_variant(symbol_name, symbol_len);
-    if (addr)
-        return addr;
+	addr = ksu_lookup_symbol_kprobe(symbol_name);
+	if (addr)
+		return addr;
 
-    return (void *)find_kernel_symbol_exact(symbol_name);
-#else
-    addr = (void *)find_kernel_symbol_exact(symbol_name);
-    if (addr)
-        return addr;
+	if (strlen(symbol_name) + sizeof(".cfi_jt") < sizeof(alt)) {
+		scnprintf(alt, sizeof(alt), "%s.cfi_jt", symbol_name);
+		addr = ksu_lookup_symbol_kprobe(alt);
+		if (addr)
+			return addr;
+	}
 
-    return resolve_symbol_variant(symbol_name, symbol_len);
-#endif
+	return 0;
+}
+
+void *ksu_resolve_symbol_for_functable_hook(const char *symbol_name)
+{
+	return (void *)find_kernel_symbol_exact(symbol_name);
 }
 
-void __init ksu_init_symbol_resolver()
+void ksu_init_symbol_resolver(void)
 {
-#if !ALWAYS_HAVE_ON_EACH_SYMBOL
-    kallsyms_on_each_symbol_fn = find_kernel_symbol_exact("kallsyms_on_each_symbol");
-    if (!kallsyms_on_each_symbol_fn) {
-        pr_warn("kallsyms_on_each_symbol not found!\n");
-    }
-#endif
-#if HAVE_ON_EACH_MATCH_SYMBOL
-    kallsyms_on_each_match_symbol_fn = find_kernel_symbol_exact("kallsyms_on_each_match_symbol");
-    if (!kallsyms_on_each_match_symbol_fn) {
-        pr_warn("kallsyms_on_each_match_symbol not found!\n");
-    }
-#endif
+	/* Nothing to pre-resolve; callers cache their own lookups. */
 }
diff --git a/kernel/infra/symbol_resolver.h b/kernel/infra/symbol_resolver.h
index 8ce4ef1..7bf2079 100644
--- a/kernel/infra/symbol_resolver.h
+++ b/kernel/infra/symbol_resolver.h
@@ -3,6 +3,14 @@
 
 void *ksu_resolve_symbol_for_functable_hook(const char *symbol_name);
 unsigned long find_kernel_symbol_exact(const char *symbol_name);
-void ksu_init_symbol_resolver();
+
+/*
+ * Resolve any kernel symbol by name, including symbols that are not exported
+ * to modules, by placing a throw-away kprobe on it.  Returns 0 if the symbol
+ * does not exist in the running kernel.  Cache the result in the caller.
+ */
+unsigned long ksu_lookup_symbol_kprobe(const char *name);
+
+void ksu_init_symbol_resolver(void);
 
 #endif
