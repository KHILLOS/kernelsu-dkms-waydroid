From b1c0227bdfa0a0a1dfc4909a474a63367ed4db1a Mon Sep 17 00:00:00 2001
From: z <x@y>
Date: Mon, 9 Nov 2026 21:16:19 +0000
Subject: [PATCH] vfs: make the anon-inode wrapper portable across 6.1-6.7

---
 kernel/infra/file_wrapper.c | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/kernel/infra/file_wrapper.c b/kernel/infra/file_wrapper.c
index e8d27f42..8a739a63 100644
--- a/kernel/infra/file_wrapper.c
+++ b/kernel/infra/file_wrapper.c
@@ -431,8 +431,12 @@ static const struct dentry_operations ksu_file_wrapper_d_ops = { .d_dname = ksu_
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 8, 0)
 #define ksu_anon_inode_create_getfile_compat anon_inode_create_getfile
-#elif LINUX_VERSION_CODE >= KERNEL_VERSION(5, 16, 0)
-#define ksu_anon_inode_create_getfile_compat anon_inode_getfile_secure
+/*
+ * On 6.1 - 6.7 anon_inode_getfile_secure() exists but is not exported to
+ * modules (only anon_inode_getfile/getfd/getfd_secure are), so an out-of-tree
+ * build cannot call it.  Fall through to the portable implementation below,
+ * which is what this code already used before 5.16.
+ */
 #else
 // There is no anon_inode_create_getfile before 5.16, but it's not difficult to implement it.
 // https://cs.android.com/android/kernel/superproject/+/common-android12-5.10:common/fs/anon_inodes.c;l=58-125;drc=0d34ce8aa78e38affbb501690bcabec4df88620e
@@ -454,11 +458,23 @@ static struct inode *ksu_anon_inode_make_secure_inode(const char *name, const st
     if (IS_ERR(inode))
         return inode;
     inode->i_flags &= ~S_PRIVATE;
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 2, 0)
+    /*
+     * security_inode_init_security_anon() only became reachable from modules in
+     * 6.2, when it was declared in include/linux/security.h.  6.1 kernels that
+     * take this path (distro kernels without anon_inode_create_getfile) build
+     * the wrapper inode without an associated security context instead.
+     */
     error = security_inode_init_security_anon(inode, &qname, context_inode);
     if (error) {
         iput(inode);
         return ERR_PTR(error);
     }
+#else
+    (void)qname;
+    (void)context_inode;
+    (void)error;
+#endif
     return inode;
 }
 
