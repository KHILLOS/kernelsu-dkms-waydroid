From 7afcad6a587f86e0d7f5d65c303920013905714c Mon Sep 17 00:00:00 2001
From: z <x@y>
Date: Mon, 9 Nov 2026 20:00:10 +0000
Subject: [PATCH] filewrapper

---
 kernel/infra/file_wrapper.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/kernel/infra/file_wrapper.c b/kernel/infra/file_wrapper.c
index 7372df0..e8d27f4 100644
--- a/kernel/infra/file_wrapper.c
+++ b/kernel/infra/file_wrapper.c
@@ -1,6 +1,7 @@
 #include <linux/gfp.h>
 #include <linux/fdtable.h>
 #include <linux/export.h>
+#include <linux/module.h>
 #include <linux/anon_inodes.h>
 #include <linux/capability.h>
 #include <linux/cred.h>
@@ -13,11 +14,15 @@
 #include <linux/version.h>
 #include <linux/mount.h>
 
+#if IS_ENABLED(CONFIG_KSU_SELINUX)
 #include "objsec.h"
+#endif
 
 #include "ksu.h"
 #include "klog.h" // IWYU pragma: keep
+#if IS_ENABLED(CONFIG_KSU_SELINUX)
 #include "selinux/selinux.h"
+#endif
 
 #include "infra/file_wrapper.h"
 
@@ -536,12 +541,17 @@ int ksu_install_file_wrapper(int fd)
     struct inode *wrapper_inode = file_inode(wrapper_file);
     // libc's stdio relies on the fstat() result of the fd to determine its buffer type.
     wrapper_inode->i_mode = file_inode(orig_file)->i_mode;
+#if IS_ENABLED(CONFIG_KSU_SELINUX)
+    // The inode security blob and its accessor only exist when the kernel's
+    // SELinux code is available.  Without CONFIG_KSU_SELINUX leave the inode
+    // label untouched (the fd then carries the caller's context).
     struct inode_security_struct *wrapper_sec = selinux_inode(wrapper_inode);
     // Use ksu_file_sid to bypass SELinux check.
     // When we call `su` from terminal app, this is useful.
     if (wrapper_sec) {
         wrapper_sec->sid = ksu_file_sid;
     }
+#endif
     // Install open file operation for inode.
     wrapper_inode->i_fop = &ksu_file_wrapper_inode_fops;
 
